# 复制此文件为 .env 或在运行前导出环境变量
# 智谱 API Key（从 https://open.bigmodel.cn/ 获取）
export LLM_API_KEY=your-deepseek-api-key
export LLM_BASE_URL=https://api.deepseek.com
export LLM_MODEL=deepseek-v4-flash
export EMBEDDING_API_KEY=your-zhipu-api-key
export EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
export EMBEDDING_MODEL=embedding-3
export DEEPSEEK_API_KEY=your-deepseek-api-key
export ZHIPU_API_KEY=your-zhipu-api-key
export APP_ADMIN_PASSWORD=optional-password

