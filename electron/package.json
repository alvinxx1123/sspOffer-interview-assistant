{
  "name": "sspoffer",
  "productName": "sspOffer",
  "version": "0.1.0",
  "private": true,
  "description": "\u4e92\u8054\u7f51\u540e\u7aef\u9762\u8bd5\u51c6\u5907\u5e73\u53f0 \u00b7 \u9762\u7ecf\u6574\u5408 \u00b7 AI \u6a21\u62df \u00b7 \u6df1\u5ea6\u590d\u76d8 \u00b7 \u5728\u7ebf\u5237\u9898",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "electron-vite preview",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/openai": "^1.5.5",
    "@monaco-editor/react": "^4.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-store": "^11.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.sspoffer.desktop",
    "productName": "sspOffer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "sspOffer.app",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "/tmp/electron-entitlements.plist",
      "entitlementsInherit": "/tmp/electron-entitlements.plist",
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "sspOffer",
        "CFBundleDisplayName": "sspOffer",
        "CFBundleExecutable": "sspOffer",
        "NSMicrophoneUsageDescription": "sspOffer \u9700\u8981\u4f7f\u7528\u9ea6\u514b\u98ce\u6765\u5f55\u5165\u4f60\u7684\u9762\u8bd5\u56de\u7b54\uff08\u8bed\u97f3\u8f6c\u6587\u5b57\uff09",
        "NSSpeechRecognitionUsageDescription": "sspOffer \u9700\u8981\u4f7f\u7528\u8bed\u97f3\u8bc6\u522b\u5c06\u4f60\u8bf4\u7684\u5185\u5bb9\u8f6c\u5199\u4e3a\u6587\u5b57",
        "LSApplicationCategoryType": "public.app-category.education"
      }
    },
    "icon": "build/icon.png",
    "npmRebuild": false
  }
}